# Bot identity
BOT_ID=bot-recruiter-1
BOT_NAME=RecruiterAgent
BOT_PUBLIC_URL=http://127.0.0.1:12120
OWNER_ID=user-alice
HOST=127.0.0.1
PORT=12120

# Persistence
DATA_DIR=./data
SQLITE_PATH=./data/bot.db
BOT_DOCS_ROOT=./data/docs
BOT_RESUME_ROOT=./data/resumes

# A2A (Agent2Agent public protocol) — Bearer token must match peer bots
A2A_BEARER_TOKEN=dev-a2a-secret-change-me
# legacy alias still accepted: A2A_SHARED_SECRET
A2A_PATH=/a2a
# 启动后自动注册到 Registry（默认本机目录；可填逗号分隔的外部 Registry 根 URL）
A2A_AUTO_REGISTER=true
A2A_HOST_REGISTRY=true
# A2A_REGISTRY_URL=http://127.0.0.1:12120,http://registry.example:9000
A2A_REGISTRY_HEARTBEAT_SEC=60

# Model: siliconflow（默认，硅基流动模型广场）| openai | ark
MODEL_TYPE=siliconflow
SILICONFLOW_API_KEY=sk-xxx
# 模型 ID 须与 https://cloud.siliconflow.cn/models 广场完全一致
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 国际站可用：https://api.siliconflow.com/v1

# 兼容别名（可选，不填则跟上面硅基流动配置）
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

# ARK_API_KEY=
# ARK_MODEL=
# ARK_BASE_URL=

# GitHub search (optional but recommended)
GITHUB_TOKEN=

# Voice ASR（硅基流动也提供语音模型时可复用同一 Key）
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_API_KEY=
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall

MAX_ITERATIONS=16
