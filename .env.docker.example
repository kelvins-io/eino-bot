# 复制为 .env.docker 后供 docker compose 读取：
#   cp .env.docker.example .env.docker
#   make docker-up

# 模型（必填）
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL_TYPE=siliconflow

# A2A（招聘方 / 人才市场 Agent 必须一致；对接 a2a-go v2 时与 Agent Market 一致）
A2A_BEARER_TOKEN=dev-a2a-secret-change-me
# 中央 Agent Market（容器内经 host.docker.internal 访问宿主机 :13100）
# 注意：勿写成 127.0.0.1（那是容器自身）。本地 .env 的 A2A_REGISTRY_URL 不会覆盖此项。
DOCKER_A2A_REGISTRY_URL=http://host.docker.internal:13100

# 宿主机映射端口（可选）
RECRUITER_HOST_PORT=12120
# 容器内仍监听 8090；宿主机默认 18090，避免与常见 :8090 服务冲突
TALENT_MARKET_HOST_PORT=18090

# Agent Market「附近」演示坐标（北京）
MARKET_LAT=39.9042
MARKET_LNG=116.4074

# GitHub / ASR（可选）
# GITHUB_TOKEN=
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
